<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Abhilipsa ❤️</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: #333;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            color: #e63946;
            margin-bottom: 10px;
            font-size: 2rem;
        }

        .subtitle {
            font-size: 1.1rem;
            color: #555;
            margin-bottom: 20px;
        }

        .counter-box {
            background: #ffe6e8;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .counter-box h2 {
            color: #d62828;
            font-size: 1.5rem;
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 10px;
            margin-bottom: 25px;
        }

        .gallery img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 10px;
            border: 2px solid #ffccd5;
        }

        .memories-list {
            text-align: left;
            background: #fff;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: inset 0 0 5px rgba(0,0,0,0.05);
        }

        .memories-list h3 {
            color: #e63946;
            margin-bottom: 10px;
        }

        .memories-list ul {
            list-style-type: '❤️ ';
            padding-left: 20px;
        }

        .memories-list li {
            margin-bottom: 8px;
            color: #444;
        }

        .music-player {
            margin-top: 20px;
        }

        iframe {
            border-radius: 12px;
            width: 100%;
            height: 80px;
            border: none;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>Abhilipsa & Golu</h1>
        <p class="subtitle">Our Special Journey Together</p>

        <div class="counter-box">
            <p>Days Together</p>
            <h2 id="days-counter">Calculating...</h2>
        </div>

        <div class="gallery">
            <img src="photo1.jpg" alt="Memory 1">
            <img src="photo2.jpg" alt="Memory 2">
            <img src="photo3.jpg" alt="Memory 3">
            <img src="photo4.jpg" alt="Memory 4">
            <img src="photo5.jpg" alt="Memory 5">
        </div>

        <div class="memories-list">
            <h3>Special Memories</h3>
            <ul>
                <li>Sneaking out to DRDO</li>
                <li>Late night rides together</li>
                <li>Endless hugs and kisses</li>
            </ul>
        </div>

        <div class="music-player">
            <p style="margin-bottom: 8px; font-weight: bold; color: #555;">🎵 Our Song: Channa Mereya</p>
            <iframe src="https://www.youtube.com/embed/bzW9fmw38y0" title="Channa Mereya" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>

    <script>
        // Personal Details Configuration
        const config = {
            herName: "Abhilipsa",
            yourName: "Golu",
            startDate: "2025-04-02",
            specialSong: {
                title: "Channa Mereya",
                link: "https://www.youtube.com/embed/bzW9fmw38y0"
            },
            photos: [
                "photo1.jpg",
                "photo2.jpg",
                "photo3.jpg",
                "photo4.jpg",
                "photo5.jpg"
            ],
            memoriesAndJokes: [
                "Sneaking out to DRDO",
                "Late night rides together",
                "Endless hugs and kisses"
            ]
        };

        // Days Counter Calculation
        function calculateDays() {
            const start = new Date(config.startDate);
            const today = new Date();
            const diffTime = Math.abs(today - start);
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            document.getElementById('days-counter').innerText = `${diffDays} Days`;
        }

        calculateDays();
    </script>
</body>
</html>
